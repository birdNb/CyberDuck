[Unit]
Description=cyberDuck wheel drive
After=multi-user.target audio-boot.service
Wants=audio-boot.service
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/aidlux/cyberDuck/motor
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/aidlux/cyberDuck/sport_ctrl/wheel_run/wheel-drive-boot.sh
Restart=on-failure
RestartSec=3
TimeoutStopSec=45
KillSignal=SIGTERM
KillMode=mixed
StandardOutput=journal
StandardError=journal
SyslogIdentifier=wheel-drive

[Install]
WantedBy=multi-user.target
