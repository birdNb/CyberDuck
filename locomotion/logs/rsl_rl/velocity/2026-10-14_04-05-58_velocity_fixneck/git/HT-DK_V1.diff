+def feet_air_time_single_stance(
+    env: ManagerBasedRlEnv,
+    sensor_name: str,
+    threshold_min: float = 0.05,
+    threshold_max: float = 0.5,
+    command_name: str | None = None,
+    command_threshold: float = 0.5,
+) -> torch.Tensor:
+    """Air-time reward that only pays a swing foot while the OTHER foot is down.
+
+    mjlab's feet_air_time pays every airborne foot independently, so a hop
+    (both feet up) earns double — the policy learns to bounce. Here a swing
+    foot counts only if the other foot is in contact (single support).
+
+    The payout ramps linearly from 0 at lift-off to 1 at threshold_min and
+    stays 1 until threshold_max, then drops to 0. A binary window gives no
+    gradient to sub-threshold shuffling steps; the ramp makes each longer
+    swing strictly more valuable, so cadence drops and stride grows.
+    Two-foot sensor only.
+    """
+    sensor = env.scene.sensors[sensor_name]
+    air_time = sensor.data.current_air_time
+    contact = sensor.data.found > 0
+    ramp = torch.clamp(air_time / threshold_min, max=1.0) * (air_time < threshold_max)
+    other_down = contact.flip(dims=(1,))
+    reward = torch.sum(ramp * other_down.float(), dim=1)
+    in_air = air_time > 0
+    env.extras["log"]["Metrics/air_time_mean"] = (
+        torch.sum(air_time * in_air) / torch.clamp(in_air.sum(), min=1)
+    )
+    if command_name is not None:
+        command = env.command_manager.get_command(command_name)
+        if command is not None:
+            total = torch.norm(command[:, :2], dim=1) + torch.abs(command[:, 2])
+            reward *= (total > command_threshold).float()
+    return reward
+
+
+def flight_phase_cost(env: ManagerBasedRlEnv, sensor_name: str) -> torch.Tensor:
+    """1 while no foot touches the ground (hopping / flight phase), else 0."""
+    found = env.scene.sensors[sensor_name].data.found
+    return (found.sum(dim=-1) == 0).float()
+
