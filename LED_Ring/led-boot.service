[Unit]
Description=cyberDuck LED ring (PIN_22 comet)
After=multi-user.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/home/aidlux/cyberDuck/LED_Ring
Environment=PYTHONUNBUFFERED=1
ExecStartPre=/bin/sh -c 'lsmod | grep -q '^ws2812_tlmm ' || insmod /home/aidlux/cyberDuck/LED_Ring/ws2812_tlmm.ko'
ExecStart=/usr/bin/python3 -u /home/aidlux/cyberDuck/LED_Ring/white_flow.py --effect comet --chip 4 --line 57 --no-sudo
Restart=on-failure
RestartSec=1
KillMode=mixed
TimeoutStopSec=3
StandardOutput=journal
StandardError=journal
SyslogIdentifier=led-boot

[Install]
WantedBy=multi-user.target
